# Optional override. If unset, Bebop discovers AO via ~/.ao/running.json
# AO_BASE_URL=http://127.0.0.1:7777/api/v1

# Optional override for AO daemon handshake file.
# AO_RUN_FILE=C:\Users\you\.ao\running.json

# Required only for OpenCode routes. Use the exact model IDs OpenCode accepts.
BEBOP_OLLAMA_MODEL=ollama/<your-model>
BEBOP_GROQ_MODEL=groq/<your-model>

# Optional verification shell selector.
# Windows defaults to powershell; AO also supports pwsh, git-bash, etc.
# BEBOP_VERIFY_SHELL=pwsh

# Optional. DBOS can use its default local configuration when unset.
# DBOS_SYSTEM_DATABASE_URL=...

# PydanticAI planner. Groq is the cheap default; any PydanticAI model string can replace it.
BEBOP_PLANNER_MODEL=groq:llama-3.3-70b-versatile
# GROQ_API_KEY=your-key-here
